PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/resume-your-college
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
CLIENT_URL=http://localhost:5173

# Configure these to enable password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Configure this to enable Groq-powered AI resume generation.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
